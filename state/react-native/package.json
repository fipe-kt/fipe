{
  "name": "fipe-state",
  "version": "1.0.0-beta.1",
  "description": "Lifecycle and concurrency primitives for React Native and TypeScript.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fipe-kt/fipe.git",
    "directory": "state/react-native"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
